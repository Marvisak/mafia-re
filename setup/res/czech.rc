// Steam's Czech setup.exe (2002-08-23): the code of August 2002 (SETUP_DATE_CZECH), from a copy of the project
// named setup_cz, built without optimization and linked with this script. Its dialog is taller and narrower
// than 1.2's; its strings are Czech, without IDS_SETUP, which that code doesn't load.

#include "resource.h"
#include <windows.h>

#pragma code_page(65001)

LANGUAGE LANG_CZECH, SUBLANG_DEFAULT

IDB_SPLASH BITMAP "splash.bmp"

STRINGTABLE
{
    IDS_DISPLAY, " Obrazovka "
    IDS_DRIVERVERSION, "Verze ovladačů: %d.%02d.%02d.%04d"
    IDS_RESOLUTION, "Rozlišení"
    IDS_ANTIALIASING, "Vyhlazování obrazu"
    IDS_AUTODETECT, "Autodetekce"
    IDS_EXIT, "Ukončit"
    IDS_SAVE, "Uložit a ukončit"
    IDS_EXPERTSETTINGS, " Další nastavení "
    IDS_HARDWARETRANSFORM, "Hardwarové transformace a nasvětlování"
    IDS_SUSPENDWHENINACTIVE, "Přerušit při přepnutí do Windows"
    IDS_FULLSCREEN, "     Celá obrazovka "
    IDS_TRIPLEBUFFERING, "Triple buffering"
    IDS_VSYNC, "Vertikální synchronizace"
    IDS_REFRESHRATE, "Obnovovací frekvence"
    IDS_BITDEPTH, "Barevná hloubka"
}

STRINGTABLE
{
    IDS_MULTIPASSRENDERING, "Víceprůchodové vykreslování"
    IDS_CLIPALWAYS, "Zapnout ořezávání"
    IDS_WBUFFER, "W Buffer"
    IDS_TEXTUREQUALITY, " Kvalita a velikost textur"
    IDS_TRUECOLOR, "Truecolor"
    IDS_LOWDETAIL, "Nízké rozlišení"
    IDS_COMPRESSED, "Komprimované"
    IDS_LIGHTMAPQUALITY, " Kvalita a velikost stínů "
    IDS_SOUND, "      Zvuk "
    IDS_SOFTWAREMIXINGONLY, "Pouze softwarové mixování"
    IDS_DISABLEEAX, "Vypnout EAX"
    IDS_OPENEXPERTSETTINGS, "Otevřít pokročilé nastavení..."
    IDS_CLOSEEXPERTSETTINGS, "Zavřít pokročilé nastavení..."
    IDS_DEFAULT, "Defaultní"
    IDS_STEREOHEADPHONES, "Stereo sluchátka"
    IDS_STEREOSPEAKERS, "Stereo reproduktory"
}

STRINGTABLE
{
    IDS_QUADROPHONICSPEAKERS, "Quadrophonické reproduktory"
    IDS_SURROUNDSPEAKERS, "5.1 surround sound reproduktory"
    IDS_OFF, " Vyp."
    IDS_SETUPERROR, "Chyba setupu"
    IDS_DIRECTXENUMERROR, "DirectX : Nemohu nalézt zobrazovací zařízení."
    IDS_LOWVRAMWARNING, "Nastavení truecolor textur je doporučeno\n\rpouze pro karty s 64MB video RAM a více.\n\rPokračovat?"
    IDS_WARNING, "Varování"
    IDS_DISCARDCHANGES, "Zrušit změny?"
}

LANGUAGE LANG_ENGLISH, SUBLANG_ENGLISH_US

IDI_SETUP ICON "mafia.ico"

IDD_MAIN DIALOGEX 0, 0, 375, 234
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_MINIMIZEBOX | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "Setup"
FONT 8, "MS Sans Serif"
{
    CONTROL IDB_SPLASH, IDC_BITMAP, STATIC, SS_BITMAP | WS_CHILD | WS_VISIBLE | WS_BORDER, 134, 5, 109, 71 
    CONTROL "", IDC_COMBO_DISPLAY, COMBOBOX, CBS_DROPDOWNLIST | WS_CHILD | WS_VISIBLE | WS_VSCROLL | WS_GROUP, 10, 15, 105, 69 
    CONTROL "", IDC_COMBO_RESOLUTION, COMBOBOX, CBS_DROPDOWNLIST | CBS_SORT | WS_CHILD | WS_VISIBLE | WS_VSCROLL | WS_GROUP, 50, 55, 65, 75 
    CONTROL "*Triple buffering", IDC_CHECK_TRIPLEBUFFERING, BUTTON, BS_AUTOCHECKBOX | BS_CENTER | BS_VCENTER | BS_PUSHLIKE | WS_CHILD | WS_VISIBLE | WS_GROUP, 135, 101, 105, 11 
    CONTROL "*Vertical synchronization", IDC_CHECK_VSYNC, BUTTON, BS_AUTOCHECKBOX | BS_CENTER | BS_VCENTER | BS_PUSHLIKE | WS_CHILD | WS_VISIBLE | WS_GROUP, 135, 115, 105, 11 
    CONTROL "*Truecolor", IDC_CHECK_TEXTURETRUECOLOR, BUTTON, BS_AUTOCHECKBOX | BS_CENTER | BS_VCENTER | BS_PUSHLIKE | WS_CHILD | WS_VISIBLE | WS_GROUP, 261, 15, 105, 11 
    CONTROL "*Low detail", IDC_CHECK_TEXTURELOWDETAIL, BUTTON, BS_AUTOCHECKBOX | BS_CENTER | BS_VCENTER | BS_PUSHLIKE | WS_CHILD | WS_VISIBLE | WS_GROUP, 261, 30, 105, 11 
    CONTROL "*Compressed", IDC_CHECK_TEXTURECOMPRESSED, BUTTON, BS_AUTOCHECKBOX | BS_CENTER | BS_VCENTER | BS_PUSHLIKE | WS_CHILD | WS_VISIBLE | WS_GROUP, 261, 45, 105, 11 
    CONTROL "*Truecolor", IDC_CHECK_LIGHTMAPTRUECOLOR, BUTTON, BS_AUTOCHECKBOX | BS_CENTER | BS_VCENTER | BS_PUSHLIKE | WS_CHILD | WS_VISIBLE | WS_GROUP, 261, 74, 105, 11 
    CONTROL "*Save and exit", IDC_BUTTON_SAVE, BUTTON, BS_DEFPUSHBUTTON | WS_CHILD | WS_VISIBLE | WS_TABSTOP, 5, 167, 115, 15 
    CONTROL "*Exit", IDC_BUTTON_EXIT, BUTTON, BS_PUSHBUTTON | WS_CHILD | WS_VISIBLE | WS_TABSTOP, 5, 147, 115, 15 
    CONTROL "", IDC_DRIVERVERSION, EDIT, ES_LEFT | ES_READONLY | WS_CHILD | WS_VISIBLE, 10, 29, 102, 12 
    CONTROL "*Disable EAX", IDC_CHECK_DISABLEEAX, BUTTON, BS_AUTOCHECKBOX | BS_CENTER | BS_VCENTER | BS_PUSHLIKE | WS_CHILD | WS_VISIBLE | WS_GROUP, 261, 134, 105, 11 
    CONTROL "*Suspend when inactive", IDC_CHECK_SUSPENDWHENINACTIVE, BUTTON, BS_AUTOCHECKBOX | BS_CENTER | BS_VCENTER | BS_PUSHLIKE | WS_CHILD | WS_VISIBLE | WS_GROUP, 14, 211, 149, 11 
    CONTROL "*Hardware Transform&&Lighting", IDC_CHECK_HARDWARETRANSFORM, BUTTON, BS_AUTOCHECKBOX | BS_CENTER | BS_VCENTER | BS_PUSHLIKE | WS_CHILD | WS_VISIBLE | WS_GROUP, 14, 196, 149, 11 
    CONTROL "     *Fullscreen ", IDC_FULLSCREEN, BUTTON, BS_GROUPBOX | WS_CHILD | WS_VISIBLE, 130, 91, 115, 92 
    CONTROL "*Refresh rate", IDC_REFRESHRATE, STATIC, SS_CENTER | SS_CENTERIMAGE | WS_CHILD | WS_VISIBLE | WS_GROUP, 136, 129, 101, 8 , WS_EX_TRANSPARENT
    CONTROL "", IDC_COMBO_REFRESHRATE, COMBOBOX, CBS_DROPDOWNLIST | WS_CHILD | WS_VISIBLE | WS_VSCROLL | WS_GROUP, 159, 140, 50, 64 
    CONTROL "*Software mixing only", IDC_CHECK_SOFTWAREMIXINGONLY, BUTTON, BS_AUTOCHECKBOX | BS_CENTER | BS_VCENTER | BS_PUSHLIKE | WS_CHILD | WS_VISIBLE | WS_GROUP, 261, 120, 105, 11 
    CONTROL "", IDC_CHECK_FULLSCREEN, BUTTON, BS_AUTOCHECKBOX | WS_CHILD | WS_VISIBLE, 136, 91, 9, 8 , WS_EX_TRANSPARENT
    CONTROL "*Bit depth", IDC_BITDEPTH, STATIC, SS_CENTER | SS_CENTERIMAGE | WS_CHILD | WS_VISIBLE | WS_GROUP, 139, 155, 94, 8 , WS_EX_TRANSPARENT
    CONTROL "", IDC_COMBO_BITDEPTH, COMBOBOX, CBS_DROPDOWNLIST | WS_CHILD | WS_VISIBLE | WS_VSCROLL | WS_GROUP, 160, 166, 50, 58 
    CONTROL " *Texture quality/size ", IDC_TEXTUREQUALITY, BUTTON, BS_GROUPBOX | WS_CHILD | WS_VISIBLE, 253, 5, 115, 55 
    CONTROL "     *Sound ", IDC_SOUND, BUTTON, BS_GROUPBOX | WS_CHILD | WS_VISIBLE, 253, 92, 115, 58 
    CONTROL "", IDC_CHECK_SOUND, BUTTON, BS_AUTOCHECKBOX | WS_CHILD | WS_VISIBLE, 261, 92, 9, 8 , WS_EX_TRANSPARENT
    CONTROL " *Lightmap quality/size ", IDC_LIGHTMAPQUALITY, BUTTON, BS_GROUPBOX | WS_CHILD | WS_VISIBLE, 253, 62, 115, 27 
    CONTROL "*Autodetect", IDC_BUTTON_AUTODETECT, BUTTON, BS_PUSHBUTTON | WS_CHILD | WS_VISIBLE | WS_TABSTOP, 5, 100, 115, 15 
    CONTROL " *Expert settings ", IDC_EXPERTSETTINGS, BUTTON, BS_GROUPBOX | WS_CHILD | WS_VISIBLE, 7, 187, 361, 40 
    CONTROL "*Open expert settings...", IDC_BUTTON_EXPERTSETTINGS, BUTTON, BS_PUSHBUTTON | WS_CHILD | WS_VISIBLE, 253, 167, 115, 15 
    CONTROL "*Clip always", IDC_CHECK_CLIPALWAYS, BUTTON, BS_AUTOCHECKBOX | BS_CENTER | BS_VCENTER | BS_PUSHLIKE | WS_CHILD | WS_VISIBLE | WS_GROUP, 178, 211, 110, 11 
    CONTROL "*Multipass rendering", IDC_CHECK_MULTIPASSRENDERING, BUTTON, BS_AUTOCHECKBOX | BS_CENTER | BS_VCENTER | BS_PUSHLIKE | WS_CHILD | WS_VISIBLE | WS_GROUP, 178, 196, 110, 11 
    CONTROL "*Fullscene antialiasing", IDC_ANTIALIASING, STATIC, SS_LEFT | WS_CHILD | WS_VISIBLE | WS_GROUP, 10, 77, 70, 8 
    CONTROL "", IDC_COMBO_ANTIALIASING, COMBOBOX, CBS_DROPDOWNLIST | WS_CHILD | WS_VISIBLE | WS_VSCROLL | WS_GROUP, 80, 75, 35, 51 
    CONTROL " *Display ", IDC_DISPLAY, BUTTON, BS_GROUPBOX | WS_CHILD | WS_VISIBLE, 5, 5, 115, 90 
    CONTROL "*Resolution", IDC_RESOLUTION, STATIC, SS_LEFT | WS_CHILD | WS_VISIBLE | WS_GROUP, 10, 58, 37, 8 
    CONTROL "", IDC_VRAMSIZE, EDIT, ES_LEFT | ES_READONLY | WS_CHILD | WS_VISIBLE, 10, 40, 102, 12 
    CONTROL "", IDC_COMBO_LANGUAGE, COMBOBOX, CBS_DROPDOWNLIST | WS_CHILD | NOT WS_VISIBLE | WS_VSCROLL | WS_TABSTOP, 263, 209, 100, 115 
    CONTROL "Language:", -1, STATIC, SS_LEFT | WS_CHILD | NOT WS_VISIBLE | WS_GROUP, 264, 193, 35, 8 
    CONTROL "", IDC_COMBO_SOUND, COMBOBOX, CBS_DROPDOWNLIST | WS_CHILD | WS_VISIBLE | WS_VSCROLL | WS_GROUP, 262, 103, 106, 69 
    CONTROL "*W Buffer", IDC_CHECK_WBUFFER, BUTTON, BS_AUTOCHECKBOX | BS_CENTER | BS_VCENTER | BS_PUSHLIKE | WS_CHILD | WS_VISIBLE | WS_GROUP, 304, 196, 52, 11
}

IDD_MAIN DLGINIT
{
    IDC_COMBO_ANTIALIASING, 0x403, 4, 0
    0x464f, 0x0046,
    0
}
