#include "resource.h"
#include <windows.h>

// 1.2 has the bitmap and the strings in Czech and everything else in English (U.S.), one block per language as in
// a VC6 resource script. RC writes the string tables after all other resources, which gives 1.2's order.
// 1.0 has no string table: its texts are in the code and in the dialog.

LANGUAGE LANG_CZECH, SUBLANG_DEFAULT

IDB_SPLASH BITMAP "splash.bmp"

#ifndef SETUP_1_0
STRINGTABLE
{
    IDS_DISPLAY, " Display "
    IDS_DRIVERVERSION, "Driver version: %d.%02d.%02d.%04d"
    IDS_RESOLUTION, "Resolution"
    IDS_ANTIALIASING, "Fullscene antialiasing"
    IDS_AUTODETECT, "Autodetect"
    IDS_EXIT, "Exit"
    IDS_SAVE, "Save and exit"
    IDS_EXPERTSETTINGS, " Expert settings "
    // Second & is missing here
    IDS_HARDWARETRANSFORM, "Hardware Transform&Lighting"
    IDS_SUSPENDWHENINACTIVE, "Suspend when inactive"
    IDS_FULLSCREEN, "     Fullscreen "
    IDS_TRIPLEBUFFERING, "Triple buffering"
    IDS_VSYNC, "Vertical synchronization"
    IDS_REFRESHRATE, 	"Refresh rate"
    IDS_BITDEPTH, "Bit depth"
}

STRINGTABLE
{
    IDS_MULTIPASSRENDERING, "Multipass rendering"
    IDS_CLIPALWAYS, "Clip always"
    IDS_WBUFFER, "W Buffer"
    IDS_TEXTUREQUALITY, " Texture quality/size "
    IDS_TRUECOLOR, "Truecolor"
    IDS_LOWDETAIL, "Low detail"
    IDS_COMPRESSED, "Compressed"
    IDS_LIGHTMAPQUALITY, " Lightmap quality/size "
    IDS_SOUND, "     Sound "
    IDS_SOFTWAREMIXINGONLY, "Software mixing only"
    IDS_DISABLEEAX, "Disable EAX"
    IDS_OPENEXPERTSETTINGS, "Open expert settings..."
    IDS_CLOSEEXPERTSETTINGS, "Close expert settings..."
    IDS_DEFAULT, "Default"
    IDS_STEREOHEADPHONES, "Stereo headphones"
    IDS_STEREOSPEAKERS, 	"Stereo speakers"
}

STRINGTABLE
{
    IDS_QUADROPHONICSPEAKERS, "Quadrophonic speakers"
    IDS_SURROUNDSPEAKERS, "5.1 surround sound speakers"
    IDS_OFF, " OFF"
    IDS_SETUPERROR, "Setup error"
    IDS_DIRECTXENUMERROR, "DirectX : Display devices could not be enumerated."
    IDS_LOWVRAMWARNING, "Selecting truecolor textures is only recommended\n\rfor video cards with 64MB video RAM or above.\n\rContinue?"
    IDS_WARNING, "Warning"
    IDS_DISCARDCHANGES, "Discard changes ?!"
    IDS_SETUP, "Setup"
}
#endif

LANGUAGE LANG_ENGLISH, SUBLANG_ENGLISH_US

IDI_SETUP ICON "mafia.ico"

#ifdef SETUP_1_0
// 1.0's dialog has the final texts. The group boxes and two of the labels have no id: 1.2 gave them ids, so that
// WM_INITDIALOG can set their texts, widened the labels "Fullscene antialiasing" and "Resolution" and put a "*" into
// every text it replaces.
IDD_MAIN DIALOGEX 0, 0, 378, 218
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_MINIMIZEBOX | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "Setup"
FONT 8, "MS Sans Serif"
{
    CONTROL IDB_SPLASH, IDC_BITMAP, STATIC, SS_BITMAP | WS_CHILD | WS_VISIBLE | WS_BORDER, 134, 5, 109, 71
    CONTROL "", IDC_COMBO_DISPLAY, COMBOBOX, CBS_DROPDOWNLIST | WS_CHILD | WS_VISIBLE | WS_VSCROLL | WS_GROUP, 10, 15, 105, 69
    CONTROL "", IDC_COMBO_RESOLUTION, COMBOBOX, CBS_DROPDOWNLIST | CBS_SORT | WS_CHILD | WS_VISIBLE | WS_VSCROLL | WS_GROUP, 50, 55, 65, 75
    CONTROL "Triple buffering", IDC_CHECK_TRIPLEBUFFERING, BUTTON, BS_AUTOCHECKBOX | BS_CENTER | BS_VCENTER | BS_PUSHLIKE | WS_CHILD | WS_VISIBLE | WS_GROUP, 135, 101, 105, 11
    CONTROL "Vertical synchronization", IDC_CHECK_VSYNC, BUTTON, BS_AUTOCHECKBOX | BS_CENTER | BS_VCENTER | BS_PUSHLIKE | WS_CHILD | WS_VISIBLE | WS_GROUP, 135, 116, 105, 11
    CONTROL "Truecolor", IDC_CHECK_TEXTURETRUECOLOR, BUTTON, BS_AUTOCHECKBOX | BS_CENTER | BS_VCENTER | BS_PUSHLIKE | WS_CHILD | WS_VISIBLE | WS_GROUP, 261, 15, 105, 11
    CONTROL "Low detail", IDC_CHECK_TEXTURELOWDETAIL, BUTTON, BS_AUTOCHECKBOX | BS_CENTER | BS_VCENTER | BS_PUSHLIKE | WS_CHILD | WS_VISIBLE | WS_GROUP, 261, 30, 105, 11
    CONTROL "Compressed", IDC_CHECK_TEXTURECOMPRESSED, BUTTON, BS_AUTOCHECKBOX | BS_CENTER | BS_VCENTER | BS_PUSHLIKE | WS_CHILD | WS_VISIBLE | WS_GROUP, 261, 45, 105, 11
    CONTROL "Truecolor", IDC_CHECK_LIGHTMAPTRUECOLOR, BUTTON, BS_AUTOCHECKBOX | BS_CENTER | BS_VCENTER | BS_PUSHLIKE | WS_CHILD | WS_VISIBLE | WS_GROUP, 261, 74, 105, 11
    CONTROL "Save and exit", IDC_BUTTON_SAVE, BUTTON, BS_DEFPUSHBUTTON | WS_CHILD | WS_VISIBLE | WS_TABSTOP, 5, 153, 115, 15
    CONTROL "Exit", IDC_BUTTON_EXIT, BUTTON, BS_PUSHBUTTON | WS_CHILD | WS_VISIBLE | WS_TABSTOP, 5, 133, 115, 15
    CONTROL "", IDC_DRIVERVERSION, EDIT, ES_LEFT | ES_READONLY | WS_CHILD | WS_VISIBLE, 10, 29, 102, 12
    CONTROL "Disable EAX", IDC_CHECK_DISABLEEAX, BUTTON, BS_AUTOCHECKBOX | BS_CENTER | BS_VCENTER | BS_PUSHLIKE | WS_CHILD | WS_VISIBLE | WS_GROUP, 261, 134, 105, 11
    CONTROL "Suspend when inactive", IDC_CHECK_SUSPENDWHENINACTIVE, BUTTON, BS_AUTOCHECKBOX | BS_CENTER | BS_VCENTER | BS_PUSHLIKE | WS_CHILD | WS_VISIBLE | WS_GROUP, 15, 196, 110, 11
    CONTROL "Hardware Transform&&Lighting", IDC_CHECK_HARDWARETRANSFORM, BUTTON, BS_AUTOCHECKBOX | BS_CENTER | BS_VCENTER | BS_PUSHLIKE | WS_CHILD | WS_VISIBLE | WS_GROUP, 15, 181, 110, 11
    CONTROL "     Fullscreen ", -1, BUTTON, BS_GROUPBOX | WS_CHILD | WS_VISIBLE, 130, 91, 115, 77
    CONTROL "Refresh rate", IDC_REFRESHRATE, STATIC, SS_CENTER | SS_CENTERIMAGE | WS_CHILD | WS_VISIBLE | WS_GROUP, 135, 134, 46, 8 , WS_EX_TRANSPARENT
    CONTROL "", IDC_COMBO_REFRESHRATE, COMBOBOX, CBS_DROPDOWNLIST | WS_CHILD | WS_VISIBLE | WS_VSCROLL | WS_GROUP, 190, 131, 50, 64
    CONTROL "Software mixing only", IDC_CHECK_SOFTWAREMIXINGONLY, BUTTON, BS_AUTOCHECKBOX | BS_CENTER | BS_VCENTER | BS_PUSHLIKE | WS_CHILD | WS_VISIBLE | WS_GROUP, 261, 120, 105, 11
    CONTROL "", IDC_CHECK_FULLSCREEN, BUTTON, BS_AUTOCHECKBOX | WS_CHILD | WS_VISIBLE, 136, 91, 9, 8 , WS_EX_TRANSPARENT
    CONTROL "Bit depth", IDC_BITDEPTH, STATIC, SS_CENTER | SS_CENTERIMAGE | WS_CHILD | WS_VISIBLE | WS_GROUP, 138, 151, 31, 8 , WS_EX_TRANSPARENT
    CONTROL "", IDC_COMBO_BITDEPTH, COMBOBOX, CBS_DROPDOWNLIST | WS_CHILD | WS_VISIBLE | WS_VSCROLL | WS_GROUP, 190, 150, 50, 58
    CONTROL " Texture quality/size ", -1, BUTTON, BS_GROUPBOX | WS_CHILD | WS_VISIBLE, 256, 5, 115, 55
    CONTROL "     Sound ", -1, BUTTON, BS_GROUPBOX | WS_CHILD | WS_VISIBLE, 256, 92, 115, 58
    CONTROL "", IDC_CHECK_SOUND, BUTTON, BS_AUTOCHECKBOX | WS_CHILD | WS_VISIBLE, 261, 92, 9, 8 , WS_EX_TRANSPARENT
    CONTROL " Lightmap quality/size ", -1, BUTTON, BS_GROUPBOX | WS_CHILD | WS_VISIBLE, 256, 62, 115, 27
    CONTROL "Autodetect", IDC_BUTTON_AUTODETECT, BUTTON, BS_PUSHBUTTON | WS_CHILD | WS_VISIBLE | WS_TABSTOP, 5, 100, 115, 15
    CONTROL " Expert settings ", -1, BUTTON, BS_GROUPBOX | WS_CHILD | WS_VISIBLE, 7, 171, 364, 40
    CONTROL " Open expert settings...", IDC_BUTTON_EXPERTSETTINGS, BUTTON, BS_PUSHBUTTON | WS_CHILD | WS_VISIBLE, 256, 153, 115, 15
    CONTROL "Clip always", IDC_CHECK_CLIPALWAYS, BUTTON, BS_AUTOCHECKBOX | BS_CENTER | BS_VCENTER | BS_PUSHLIKE | WS_CHILD | WS_VISIBLE | WS_GROUP, 135, 196, 52, 11
    CONTROL "Multipass rendering", IDC_CHECK_MULTIPASSRENDERING, BUTTON, BS_AUTOCHECKBOX | BS_CENTER | BS_VCENTER | BS_PUSHLIKE | WS_CHILD | WS_VISIBLE | WS_GROUP, 135, 181, 110, 11
    CONTROL "Fullscene antialiasing", -1, STATIC, SS_LEFT | WS_CHILD | WS_VISIBLE | WS_GROUP, 10, 77, 68, 8
    CONTROL "", IDC_COMBO_ANTIALIASING, COMBOBOX, CBS_DROPDOWNLIST | WS_CHILD | WS_VISIBLE | WS_VSCROLL | WS_GROUP, 80, 75, 35, 51
    CONTROL " Display ", -1, BUTTON, BS_GROUPBOX | WS_CHILD | WS_VISIBLE, 5, 5, 115, 90
    CONTROL "Resolution", -1, STATIC, SS_LEFT | WS_CHILD | WS_VISIBLE | WS_GROUP, 10, 58, 34, 8
    CONTROL "", IDC_VRAMSIZE, EDIT, ES_LEFT | ES_READONLY | WS_CHILD | WS_VISIBLE, 10, 40, 102, 12
    CONTROL "", IDC_COMBO_LANGUAGE, COMBOBOX, CBS_DROPDOWNLIST | WS_CHILD | NOT WS_VISIBLE | WS_VSCROLL | WS_TABSTOP, 264, 194, 100, 115
    CONTROL "Language:", -1, STATIC, SS_LEFT | WS_CHILD | NOT WS_VISIBLE | WS_GROUP, 265, 182, 35, 8
    CONTROL "", IDC_COMBO_SOUND, COMBOBOX, CBS_DROPDOWNLIST | WS_CHILD | WS_VISIBLE | WS_VSCROLL | WS_GROUP, 261, 103, 106, 69
    CONTROL "W Buffer", IDC_CHECK_WBUFFER, BUTTON, BS_AUTOCHECKBOX | BS_CENTER | BS_VCENTER | BS_PUSHLIKE | WS_CHILD | WS_VISIBLE | WS_GROUP, 193, 196, 52, 11
}
#else
IDD_MAIN DIALOGEX 0, 0, 378, 218
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_MINIMIZEBOX | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "Setup"
FONT 8, "MS Sans Serif"
{
    CONTROL IDB_SPLASH, IDC_BITMAP, STATIC, SS_BITMAP | WS_CHILD | WS_VISIBLE | WS_BORDER, 134, 5, 109, 71 
    CONTROL "", IDC_COMBO_DISPLAY, COMBOBOX, CBS_DROPDOWNLIST | WS_CHILD | WS_VISIBLE | WS_VSCROLL | WS_GROUP, 10, 15, 105, 69 
    CONTROL "", IDC_COMBO_RESOLUTION, COMBOBOX, CBS_DROPDOWNLIST | CBS_SORT | WS_CHILD | WS_VISIBLE | WS_VSCROLL | WS_GROUP, 50, 55, 65, 75 
    CONTROL "*Triple buffering", IDC_CHECK_TRIPLEBUFFERING, BUTTON, BS_AUTOCHECKBOX | BS_CENTER | BS_VCENTER | BS_PUSHLIKE | WS_CHILD | WS_VISIBLE | WS_GROUP, 135, 101, 105, 11 
    CONTROL "*Vertical synchronization", IDC_CHECK_VSYNC, BUTTON, BS_AUTOCHECKBOX | BS_CENTER | BS_VCENTER | BS_PUSHLIKE | WS_CHILD | WS_VISIBLE | WS_GROUP, 135, 116, 105, 11 
    CONTROL "*Truecolor", IDC_CHECK_TEXTURETRUECOLOR, BUTTON, BS_AUTOCHECKBOX | BS_CENTER | BS_VCENTER | BS_PUSHLIKE | WS_CHILD | WS_VISIBLE | WS_GROUP, 261, 15, 105, 11 
    CONTROL "*Low detail", IDC_CHECK_TEXTURELOWDETAIL, BUTTON, BS_AUTOCHECKBOX | BS_CENTER | BS_VCENTER | BS_PUSHLIKE | WS_CHILD | WS_VISIBLE | WS_GROUP, 261, 30, 105, 11 
    CONTROL "*Compressed", IDC_CHECK_TEXTURECOMPRESSED, BUTTON, BS_AUTOCHECKBOX | BS_CENTER | BS_VCENTER | BS_PUSHLIKE | WS_CHILD | WS_VISIBLE | WS_GROUP, 261, 45, 105, 11 
    CONTROL "*Truecolor", IDC_CHECK_LIGHTMAPTRUECOLOR, BUTTON, BS_AUTOCHECKBOX | BS_CENTER | BS_VCENTER | BS_PUSHLIKE | WS_CHILD | WS_VISIBLE | WS_GROUP, 261, 74, 105, 11 
    CONTROL "*Save and exit", IDC_BUTTON_SAVE, BUTTON, BS_DEFPUSHBUTTON | WS_CHILD | WS_VISIBLE | WS_TABSTOP, 5, 153, 115, 15 
    CONTROL "*Exit", IDC_BUTTON_EXIT, BUTTON, BS_PUSHBUTTON | WS_CHILD | WS_VISIBLE | WS_TABSTOP, 5, 133, 115, 15 
    CONTROL "", IDC_DRIVERVERSION, EDIT, ES_LEFT | ES_READONLY | WS_CHILD | WS_VISIBLE, 10, 29, 102, 12 
    CONTROL "*Disable EAX", IDC_CHECK_DISABLEEAX, BUTTON, BS_AUTOCHECKBOX | BS_CENTER | BS_VCENTER | BS_PUSHLIKE | WS_CHILD | WS_VISIBLE | WS_GROUP, 261, 134, 105, 11 
    CONTROL "*Suspend when inactive", IDC_CHECK_SUSPENDWHENINACTIVE, BUTTON, BS_AUTOCHECKBOX | BS_CENTER | BS_VCENTER | BS_PUSHLIKE | WS_CHILD | WS_VISIBLE | WS_GROUP, 15, 196, 110, 11 
    CONTROL "*Hardware Transform&&Lighting", IDC_CHECK_HARDWARETRANSFORM, BUTTON, BS_AUTOCHECKBOX | BS_CENTER | BS_VCENTER | BS_PUSHLIKE | WS_CHILD | WS_VISIBLE | WS_GROUP, 15, 181, 110, 11 
    CONTROL "     *Fullscreen ", IDC_FULLSCREEN, BUTTON, BS_GROUPBOX | WS_CHILD | WS_VISIBLE, 130, 91, 115, 77 
    CONTROL "*Refresh rate", IDC_REFRESHRATE, STATIC, SS_CENTER | SS_CENTERIMAGE | WS_CHILD | WS_VISIBLE | WS_GROUP, 135, 134, 46, 8 , WS_EX_TRANSPARENT
    CONTROL "", IDC_COMBO_REFRESHRATE, COMBOBOX, CBS_DROPDOWNLIST | WS_CHILD | WS_VISIBLE | WS_VSCROLL | WS_GROUP, 190, 131, 50, 64 
    CONTROL "*Software mixing only", IDC_CHECK_SOFTWAREMIXINGONLY, BUTTON, BS_AUTOCHECKBOX | BS_CENTER | BS_VCENTER | BS_PUSHLIKE | WS_CHILD | WS_VISIBLE | WS_GROUP, 261, 120, 105, 11 
    CONTROL "", IDC_CHECK_FULLSCREEN, BUTTON, BS_AUTOCHECKBOX | WS_CHILD | WS_VISIBLE, 136, 91, 9, 8 , WS_EX_TRANSPARENT
    CONTROL "*Bit depth", IDC_BITDEPTH, STATIC, SS_CENTER | SS_CENTERIMAGE | WS_CHILD | WS_VISIBLE | WS_GROUP, 138, 151, 31, 8 , WS_EX_TRANSPARENT
    CONTROL "", IDC_COMBO_BITDEPTH, COMBOBOX, CBS_DROPDOWNLIST | WS_CHILD | WS_VISIBLE | WS_VSCROLL | WS_GROUP, 190, 150, 50, 58 
    CONTROL " *Texture quality/size ", IDC_TEXTUREQUALITY, BUTTON, BS_GROUPBOX | WS_CHILD | WS_VISIBLE, 256, 5, 115, 55 
    CONTROL "     *Sound ", IDC_SOUND, BUTTON, BS_GROUPBOX | WS_CHILD | WS_VISIBLE, 256, 92, 115, 58 
    CONTROL "", IDC_CHECK_SOUND, BUTTON, BS_AUTOCHECKBOX | WS_CHILD | WS_VISIBLE, 261, 92, 9, 8 , WS_EX_TRANSPARENT
    CONTROL " *Lightmap quality/size ", IDC_LIGHTMAPQUALITY, BUTTON, BS_GROUPBOX | WS_CHILD | WS_VISIBLE, 256, 62, 115, 27 
    CONTROL "*Autodetect", IDC_BUTTON_AUTODETECT, BUTTON, BS_PUSHBUTTON | WS_CHILD | WS_VISIBLE | WS_TABSTOP, 5, 100, 115, 15 
    CONTROL " *Expert settings ", IDC_EXPERTSETTINGS, BUTTON, BS_GROUPBOX | WS_CHILD | WS_VISIBLE, 7, 171, 364, 40 
    CONTROL "*Open expert settings...", IDC_BUTTON_EXPERTSETTINGS, BUTTON, BS_PUSHBUTTON | WS_CHILD | WS_VISIBLE, 256, 153, 115, 15 
    CONTROL "*Clip always", IDC_CHECK_CLIPALWAYS, BUTTON, BS_AUTOCHECKBOX | BS_CENTER | BS_VCENTER | BS_PUSHLIKE | WS_CHILD | WS_VISIBLE | WS_GROUP, 135, 196, 52, 11 
    CONTROL "*Multipass rendering", IDC_CHECK_MULTIPASSRENDERING, BUTTON, BS_AUTOCHECKBOX | BS_CENTER | BS_VCENTER | BS_PUSHLIKE | WS_CHILD | WS_VISIBLE | WS_GROUP, 135, 181, 110, 11 
    CONTROL "*Fullscene antialiasing", IDC_ANTIALIASING, STATIC, SS_LEFT | WS_CHILD | WS_VISIBLE | WS_GROUP, 10, 77, 70, 8 
    CONTROL "", IDC_COMBO_ANTIALIASING, COMBOBOX, CBS_DROPDOWNLIST | WS_CHILD | WS_VISIBLE | WS_VSCROLL | WS_GROUP, 80, 75, 35, 51 
    CONTROL " *Display ", IDC_DISPLAY, BUTTON, BS_GROUPBOX | WS_CHILD | WS_VISIBLE, 5, 5, 115, 90 
    CONTROL "*Resolution", IDC_RESOLUTION, STATIC, SS_LEFT | WS_CHILD | WS_VISIBLE | WS_GROUP, 10, 58, 37, 8 
    CONTROL "", IDC_VRAMSIZE, EDIT, ES_LEFT | ES_READONLY | WS_CHILD | WS_VISIBLE, 10, 40, 102, 12 
    CONTROL "", IDC_COMBO_LANGUAGE, COMBOBOX, CBS_DROPDOWNLIST | WS_CHILD | NOT WS_VISIBLE | WS_VSCROLL | WS_TABSTOP, 264, 194, 100, 115 
    CONTROL "Language:", -1, STATIC, SS_LEFT | WS_CHILD | NOT WS_VISIBLE | WS_GROUP, 265, 182, 35, 8 
    CONTROL "", IDC_COMBO_SOUND, COMBOBOX, CBS_DROPDOWNLIST | WS_CHILD | WS_VISIBLE | WS_VSCROLL | WS_GROUP, 261, 103, 106, 69 
    CONTROL "*W Buffer", IDC_CHECK_WBUFFER, BUTTON, BS_AUTOCHECKBOX | BS_CENTER | BS_VCENTER | BS_PUSHLIKE | WS_CHILD | WS_VISIBLE | WS_GROUP, 193, 196, 52, 11
}
#endif

// The antialiasing combo box's initial items from the dialog editor, CB_ADDSTRING (WM_USER + 3) "OFF". Only MFC
// reads them, DialogBoxParam ignores the resource.
IDD_MAIN DLGINIT
{
    IDC_COMBO_ANTIALIASING, 0x403, 4, 0
    0x464f, 0x0046,
    0
}
