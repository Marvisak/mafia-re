// Steam's Italian setup.exe: its 2010 rebuild with these resources written over the English ones after the link
// (tools/localize.py). The strings stay Czech-tagged, as in every setup. The type 255 resource holds 0x0405, Czech's
// language id: the localization added it, to an unknown end.
// Its strings lack à and è ("Profonditr", "c raccomandato"), as the original's do: the text was read as Central
// European (code page 1250) and flattened to ASCII on its way in.

#include "resource.h"
#include <windows.h>

#pragma code_page(65001)

LANGUAGE LANG_CZECH, SUBLANG_DEFAULT

STRINGTABLE
{
    IDS_DISPLAY, " Grafica "
    IDS_DRIVERVERSION, "Versione driver: %d.%02d.%02d.%04d"
    IDS_RESOLUTION, "Risoluzione"
    IDS_ANTIALIASING, "Antialias completo "
    IDS_AUTODETECT, "Rilevamento automatico"
    IDS_EXIT, "Esci"
    IDS_SAVE, "Salva ed esci"
    IDS_EXPERTSETTINGS, " Impostazioni avanzate "
    IDS_HARDWARETRANSFORM, "Trasformazione e illuminazione hardware"
    IDS_SUSPENDWHENINACTIVE, "Sospendi se inattivo"
    IDS_FULLSCREEN, "     Schermo intero "
    IDS_TRIPLEBUFFERING, "Triplo buffering"
    IDS_VSYNC, "Sincronia verticale"
    IDS_REFRESHRATE, "Rateo di aggiornamento"
    IDS_BITDEPTH, "Profonditr bit"
}

STRINGTABLE
{
    IDS_MULTIPASSRENDERING, "Rendering accurato"
    IDS_CLIPALWAYS, "Clip sempre"
    IDS_WBUFFER, "W Buffer"
    IDS_TEXTUREQUALITY, " Qualitr/dimensioni texture "
    IDS_TRUECOLOR, "Truecolor"
    IDS_LOWDETAIL, "Semplificate"
    IDS_COMPRESSED, "Compresse"
    IDS_LIGHTMAPQUALITY, " Qualitr/dimensione luci "
    IDS_SOUND, "     Audio "
    IDS_SOFTWAREMIXINGONLY, "Solo mixaggio software"
    IDS_DISABLEEAX, "Disabilita EAX"
    IDS_OPENEXPERTSETTINGS, "Apri le impostazioni avanzate..."
    IDS_CLOSEEXPERTSETTINGS, "Chiudi le impostazioni avanzate..."
    IDS_DEFAULT, "Predefiniti"
    IDS_STEREOHEADPHONES, "Cuffie stereo"
    IDS_STEREOSPEAKERS, "Altoparlanti stereo"
}

STRINGTABLE
{
    IDS_QUADROPHONICSPEAKERS, "Altoparlanti quadrifonici"
    IDS_SURROUNDSPEAKERS, "Altoparlanti 5.1 surround"
    IDS_OFF, " OFF"
    IDS_SETUPERROR, "Errore d'impostazione"
    IDS_DIRECTXENUMERROR, "DirectX: dispositivo video non elencato."
    IDS_LOWVRAMWARNING, "Selezionare le texture truecolor c raccomandato solo\n\rper schede grafiche con almeno 64MB di RAM video.\n\rContinuare?"
    IDS_WARNING, "Attenzione"
    IDS_DISCARDCHANGES, "Annullare le modifiche?!"
    IDS_SETUP, "Impostazione"
}

1 255
{
    0x0405, 0x0000
}

LANGUAGE LANG_ENGLISH, SUBLANG_ENGLISH_US

IDD_MAIN DIALOGEX 0, 0, 415, 218
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_MINIMIZEBOX | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "Setup"
FONT 8, "MS Sans Serif"
{
    CONTROL IDB_SPLASH, IDC_BITMAP, STATIC, SS_BITMAP | WS_CHILD | WS_VISIBLE | WS_BORDER, 144, 5, 109, 71 
    CONTROL "", IDC_COMBO_DISPLAY, COMBOBOX, CBS_DROPDOWNLIST | WS_CHILD | WS_VISIBLE | WS_VSCROLL | WS_GROUP, 10, 15, 105, 69 
    CONTROL "", IDC_COMBO_RESOLUTION, COMBOBOX, CBS_DROPDOWNLIST | CBS_SORT | WS_CHILD | WS_VISIBLE | WS_VSCROLL | WS_GROUP, 50, 55, 65, 75 
    CONTROL "*Triple buffering", IDC_CHECK_TRIPLEBUFFERING, BUTTON, BS_AUTOCHECKBOX | BS_CENTER | BS_VCENTER | BS_PUSHLIKE | WS_CHILD | WS_VISIBLE | WS_GROUP, 135, 101, 128, 11 
    CONTROL "*Vertical synchronization", IDC_CHECK_VSYNC, BUTTON, BS_AUTOCHECKBOX | BS_CENTER | BS_VCENTER | BS_PUSHLIKE | WS_CHILD | WS_VISIBLE | WS_GROUP, 135, 116, 128, 11 
    CONTROL "*Truecolor", IDC_CHECK_TEXTURETRUECOLOR, BUTTON, BS_AUTOCHECKBOX | BS_CENTER | BS_VCENTER | BS_PUSHLIKE | WS_CHILD | WS_VISIBLE | WS_GROUP, 283, 15, 119, 11 
    CONTROL "*Low detail", IDC_CHECK_TEXTURELOWDETAIL, BUTTON, BS_AUTOCHECKBOX | BS_CENTER | BS_VCENTER | BS_PUSHLIKE | WS_CHILD | WS_VISIBLE | WS_GROUP, 283, 30, 119, 11 
    CONTROL "*Compressed", IDC_CHECK_TEXTURECOMPRESSED, BUTTON, BS_AUTOCHECKBOX | BS_CENTER | BS_VCENTER | BS_PUSHLIKE | WS_CHILD | WS_VISIBLE | WS_GROUP, 283, 45, 119, 11 
    CONTROL "*Truecolor", IDC_CHECK_LIGHTMAPTRUECOLOR, BUTTON, BS_AUTOCHECKBOX | BS_CENTER | BS_VCENTER | BS_PUSHLIKE | WS_CHILD | WS_VISIBLE | WS_GROUP, 283, 74, 119, 11 
    CONTROL "*Save and exit", IDC_BUTTON_SAVE, BUTTON, BS_DEFPUSHBUTTON | WS_CHILD | WS_VISIBLE | WS_TABSTOP, 5, 153, 115, 15 
    CONTROL "*Exit", IDC_BUTTON_EXIT, BUTTON, BS_PUSHBUTTON | WS_CHILD | WS_VISIBLE | WS_TABSTOP, 5, 133, 115, 15 
    CONTROL "", IDC_DRIVERVERSION, EDIT, ES_LEFT | ES_READONLY | WS_CHILD | WS_VISIBLE, 10, 29, 102, 12 
    CONTROL "*Disable EAX", IDC_CHECK_DISABLEEAX, BUTTON, BS_AUTOCHECKBOX | BS_CENTER | BS_VCENTER | BS_PUSHLIKE | WS_CHILD | WS_VISIBLE | WS_GROUP, 283, 134, 119, 11 
    CONTROL "*Suspend when inactive", IDC_CHECK_SUSPENDWHENINACTIVE, BUTTON, BS_AUTOCHECKBOX | BS_CENTER | BS_VCENTER | BS_PUSHLIKE | WS_CHILD | WS_VISIBLE | WS_GROUP, 15, 196, 141, 11 
    CONTROL "*Hardware Transform&&Lighting", IDC_CHECK_HARDWARETRANSFORM, BUTTON, BS_AUTOCHECKBOX | BS_CENTER | BS_VCENTER | BS_PUSHLIKE | WS_CHILD | WS_VISIBLE | WS_GROUP, 15, 181, 141, 11 
    CONTROL "     *Fullscreen ", IDC_FULLSCREEN, BUTTON, BS_GROUPBOX | WS_CHILD | WS_VISIBLE, 130, 91, 140, 77 
    CONTROL "*Refresh rate", IDC_REFRESHRATE, STATIC, SS_LEFT | SS_CENTERIMAGE | WS_CHILD | WS_VISIBLE | WS_GROUP, 133, 134, 83, 8 , WS_EX_TRANSPARENT
    CONTROL "", IDC_COMBO_REFRESHRATE, COMBOBOX, CBS_DROPDOWNLIST | WS_CHILD | WS_VISIBLE | WS_VSCROLL | WS_GROUP, 221, 131, 42, 64 
    CONTROL "*Software mixing only", IDC_CHECK_SOFTWAREMIXINGONLY, BUTTON, BS_AUTOCHECKBOX | BS_CENTER | BS_VCENTER | BS_PUSHLIKE | WS_CHILD | WS_VISIBLE | WS_GROUP, 283, 120, 119, 11 
    CONTROL "", IDC_CHECK_FULLSCREEN, BUTTON, BS_AUTOCHECKBOX | WS_CHILD | WS_VISIBLE, 136, 91, 9, 8 , WS_EX_TRANSPARENT
    CONTROL "*Bit depth", IDC_BITDEPTH, STATIC, SS_LEFT | SS_CENTERIMAGE | WS_CHILD | WS_VISIBLE | WS_GROUP, 133, 151, 66, 8 , WS_EX_TRANSPARENT
    CONTROL "", IDC_COMBO_BITDEPTH, COMBOBOX, CBS_DROPDOWNLIST | WS_CHILD | WS_VISIBLE | WS_VSCROLL | WS_GROUP, 221, 150, 42, 58 
    CONTROL " *Texture quality/size ", IDC_TEXTUREQUALITY, BUTTON, BS_GROUPBOX | WS_CHILD | WS_VISIBLE, 278, 5, 130, 55 
    CONTROL "     *Sound ", IDC_SOUND, BUTTON, BS_GROUPBOX | WS_CHILD | WS_VISIBLE, 278, 92, 130, 58 
    CONTROL "", IDC_CHECK_SOUND, BUTTON, BS_AUTOCHECKBOX | WS_CHILD | WS_VISIBLE, 284, 92, 9, 8 , WS_EX_TRANSPARENT
    CONTROL " *Lightmap quality/size ", IDC_LIGHTMAPQUALITY, BUTTON, BS_GROUPBOX | WS_CHILD | WS_VISIBLE, 278, 62, 130, 27 
    CONTROL "*Autodetect", IDC_BUTTON_AUTODETECT, BUTTON, BS_PUSHBUTTON | WS_CHILD | WS_VISIBLE | WS_TABSTOP, 5, 100, 115, 15 
    CONTROL " *Expert settings ", IDC_EXPERTSETTINGS, BUTTON, BS_GROUPBOX | WS_CHILD | WS_VISIBLE, 7, 171, 401, 40 
    CONTROL "*Open expert settings...", IDC_BUTTON_EXPERTSETTINGS, BUTTON, BS_PUSHBUTTON | WS_CHILD | WS_VISIBLE, 278, 153, 130, 15 
    CONTROL "*Clip always", IDC_CHECK_CLIPALWAYS, BUTTON, BS_AUTOCHECKBOX | BS_CENTER | BS_VCENTER | BS_PUSHLIKE | WS_CHILD | WS_VISIBLE | WS_GROUP, 163, 196, 68, 11 
    CONTROL "*Multipass rendering", IDC_CHECK_MULTIPASSRENDERING, BUTTON, BS_AUTOCHECKBOX | BS_CENTER | BS_VCENTER | BS_PUSHLIKE | WS_CHILD | WS_VISIBLE | WS_GROUP, 163, 181, 130, 11 
    CONTROL "*Fullscene antialiasing", IDC_ANTIALIASING, STATIC, SS_LEFT | WS_CHILD | WS_VISIBLE | WS_GROUP, 10, 77, 70, 8 
    CONTROL "", IDC_COMBO_ANTIALIASING, COMBOBOX, CBS_DROPDOWNLIST | WS_CHILD | WS_VISIBLE | WS_VSCROLL | WS_GROUP, 80, 75, 35, 51 
    CONTROL " *Display ", IDC_DISPLAY, BUTTON, BS_GROUPBOX | WS_CHILD | WS_VISIBLE, 5, 5, 115, 90 
    CONTROL "*Resolution", IDC_RESOLUTION, STATIC, SS_LEFT | WS_CHILD | WS_VISIBLE | WS_GROUP, 10, 58, 37, 8 
    CONTROL "", IDC_VRAMSIZE, EDIT, ES_LEFT | ES_READONLY | WS_CHILD | WS_VISIBLE, 10, 40, 102, 12 
    CONTROL "", IDC_COMBO_LANGUAGE, COMBOBOX, CBS_DROPDOWNLIST | WS_CHILD | NOT WS_VISIBLE | WS_VSCROLL | WS_TABSTOP, 303, 194, 100, 115 
    CONTROL "Language:", -1, STATIC, SS_LEFT | WS_CHILD | NOT WS_VISIBLE | WS_GROUP, 304, 182, 35, 8 
    CONTROL "", IDC_COMBO_SOUND, COMBOBOX, CBS_DROPDOWNLIST | WS_CHILD | WS_VISIBLE | WS_VSCROLL | WS_GROUP, 284, 103, 120, 69 
    CONTROL "*W Buffer", IDC_CHECK_WBUFFER, BUTTON, BS_AUTOCHECKBOX | BS_CENTER | BS_VCENTER | BS_PUSHLIKE | WS_CHILD | WS_VISIBLE | WS_GROUP, 238, 196, 55, 11
}
