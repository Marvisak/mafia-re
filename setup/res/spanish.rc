// Steam's Spanish setup.exe: its 2010 rebuild with these resources written over the English ones after the link
// (tools/localize.py). The strings stay Czech-tagged, as in every setup. The type 255 resource holds 0x0405, Czech's
// language id: the localization added it, to an unknown end.
// Its dialog is Spanish-tagged and replaces the English one. IDS_LOWVRAMWARNING's "vídeon" is the original's: a \n
// lost its backslash.

#include "resource.h"
#include <windows.h>

#pragma code_page(65001)

LANGUAGE LANG_CZECH, SUBLANG_DEFAULT

STRINGTABLE
{
    IDS_DISPLAY, " Pantalla "
    IDS_DRIVERVERSION, "Versión del controlador: %d.%02d.%02d.%04d"
    IDS_RESOLUTION, "Resolución"
    IDS_ANTIALIASING, "Antialiasing de pant."
    IDS_AUTODETECT, "Autodetección"
    IDS_EXIT, "Salir"
    IDS_SAVE, "Guardar y salir"
    IDS_EXPERTSETTINGS, " Ajustes Expertos "
    IDS_HARDWARETRANSFORM, "Iluminación y transformación por hardware"
    IDS_SUSPENDWHENINACTIVE, "Suspender por inactividad"
    IDS_FULLSCREEN, "     Pantalla completa "
    IDS_TRIPLEBUFFERING, "Triple Buffering"
    IDS_VSYNC, "Sincronización Vertical"
    IDS_REFRESHRATE, "T. de refresco"
    IDS_BITDEPTH, "Prof. color"
}

STRINGTABLE
{
    IDS_MULTIPASSRENDERING, "Multipase de Renderizado"
    IDS_CLIPALWAYS, "Recortar Siempre"
    IDS_WBUFFER, "W Buffer"
    IDS_TEXTUREQUALITY, " Tamaño/Calidad de textura "
    IDS_TRUECOLOR, "Color verdadero"
    IDS_LOWDETAIL, "Detalles bajos"
    IDS_COMPRESSED, "Comprimido"
    IDS_LIGHTMAPQUALITY, " Tamaño/Calidad mapa de luces "
    IDS_SOUND, "     Sonido "
    IDS_SOFTWAREMIXINGONLY, "Solo mezclas por Software"
    IDS_DISABLEEAX, "Desactivar EAX"
    IDS_OPENEXPERTSETTINGS, "Abrir ajustes expertos..."
    IDS_CLOSEEXPERTSETTINGS, "Cerrar ajustes expertos..."
    IDS_DEFAULT, "Por defecto"
    IDS_STEREOHEADPHONES, "Auriculares Estéreo"
    IDS_STEREOSPEAKERS, "Altavoces Estéreo"
}

STRINGTABLE
{
    IDS_QUADROPHONICSPEAKERS, "Altavoces cuadrafónicos"
    IDS_SURROUNDSPEAKERS, "Altavoces sonido surround 5.1"
    IDS_OFF, " NO"
    IDS_SETUPERROR, "Error en Configuración"
    IDS_DIRECTXENUMERROR, "DirectX: Los dispositivos de pantalla no se pueden enumerar."
    IDS_LOWVRAMWARNING, "se recomienda seleccionar texturas en color verdadero solamente para las tarjetas de vídeon\rcon 64MB de RAM o más. \n\r ¿Quieres continuar?"
    IDS_WARNING, "Advertencia"
    IDS_DISCARDCHANGES, "¿Quieres descartar los cambios?"
    IDS_SETUP, "Configuración"
}

1 255
{
    0x0405, 0x0000
}

LANGUAGE LANG_SPANISH, SUBLANG_SPANISH_MODERN

IDD_MAIN DIALOGEX 0, 0, 426, 218
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_MINIMIZEBOX | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "Setup"
FONT 8, "MS Sans Serif"
{
    CONTROL IDB_SPLASH, IDC_BITMAP, STATIC, SS_BITMAP | WS_CHILD | WS_VISIBLE | WS_BORDER, 144, 5, 109, 71 
    CONTROL "", IDC_COMBO_DISPLAY, COMBOBOX, CBS_DROPDOWNLIST | WS_CHILD | WS_VISIBLE | WS_VSCROLL | WS_GROUP, 10, 15, 105, 69 
    CONTROL "", IDC_COMBO_RESOLUTION, COMBOBOX, CBS_DROPDOWNLIST | CBS_SORT | WS_CHILD | WS_VISIBLE | WS_VSCROLL | WS_GROUP, 50, 62, 65, 75 
    CONTROL "*Triple buffering", IDC_CHECK_TRIPLEBUFFERING, BUTTON, BS_AUTOCHECKBOX | BS_CENTER | BS_VCENTER | BS_PUSHLIKE | WS_CHILD | WS_VISIBLE | WS_GROUP, 135, 101, 128, 11 
    CONTROL "*Vertical synchronization", IDC_CHECK_VSYNC, BUTTON, BS_AUTOCHECKBOX | BS_CENTER | BS_VCENTER | BS_PUSHLIKE | WS_CHILD | WS_VISIBLE | WS_GROUP, 135, 116, 128, 11 
    CONTROL "*Truecolor", IDC_CHECK_TEXTURETRUECOLOR, BUTTON, BS_AUTOCHECKBOX | BS_CENTER | BS_VCENTER | BS_PUSHLIKE | WS_CHILD | WS_VISIBLE | WS_GROUP, 283, 15, 129, 11 
    CONTROL "*Low detail", IDC_CHECK_TEXTURELOWDETAIL, BUTTON, BS_AUTOCHECKBOX | BS_CENTER | BS_VCENTER | BS_PUSHLIKE | WS_CHILD | WS_VISIBLE | WS_GROUP, 283, 30, 129, 11 
    CONTROL "*Compressed", IDC_CHECK_TEXTURECOMPRESSED, BUTTON, BS_AUTOCHECKBOX | BS_CENTER | BS_VCENTER | BS_PUSHLIKE | WS_CHILD | WS_VISIBLE | WS_GROUP, 283, 45, 129, 11 
    CONTROL "*Truecolor", IDC_CHECK_LIGHTMAPTRUECOLOR, BUTTON, BS_AUTOCHECKBOX | BS_CENTER | BS_VCENTER | BS_PUSHLIKE | WS_CHILD | WS_VISIBLE | WS_GROUP, 283, 74, 129, 11 
    CONTROL "*Save and exit", IDC_BUTTON_SAVE, BUTTON, BS_DEFPUSHBUTTON | WS_CHILD | WS_VISIBLE | WS_TABSTOP, 5, 153, 115, 15 
    CONTROL "*Exit", IDC_BUTTON_EXIT, BUTTON, BS_PUSHBUTTON | WS_CHILD | WS_VISIBLE | WS_TABSTOP, 5, 133, 115, 15 
    CONTROL "", IDC_DRIVERVERSION, EDIT, ES_LEFT | ES_MULTILINE | ES_READONLY | WS_CHILD | WS_VISIBLE, 10, 29, 102, 18 
    CONTROL "*Disable EAX", IDC_CHECK_DISABLEEAX, BUTTON, BS_AUTOCHECKBOX | BS_CENTER | BS_VCENTER | BS_PUSHLIKE | WS_CHILD | WS_VISIBLE | WS_GROUP, 283, 134, 129, 11 
    CONTROL "*Suspend when inactive", IDC_CHECK_SUSPENDWHENINACTIVE, BUTTON, BS_AUTOCHECKBOX | BS_CENTER | BS_VCENTER | BS_PUSHLIKE | WS_CHILD | WS_VISIBLE | WS_GROUP, 15, 196, 188, 11 
    CONTROL "*Hardware Transform&&Lighting", IDC_CHECK_HARDWARETRANSFORM, BUTTON, BS_AUTOCHECKBOX | BS_CENTER | BS_VCENTER | BS_PUSHLIKE | WS_CHILD | WS_VISIBLE | WS_GROUP, 15, 181, 188, 11 
    CONTROL "     *Fullscreen ", IDC_FULLSCREEN, BUTTON, BS_GROUPBOX | WS_CHILD | WS_VISIBLE, 130, 91, 140, 77 
    CONTROL "*Refresh rate", IDC_REFRESHRATE, STATIC, SS_LEFT | SS_CENTERIMAGE | WS_CHILD | WS_VISIBLE | WS_GROUP, 133, 134, 66, 8 , WS_EX_TRANSPARENT
    CONTROL "", IDC_COMBO_REFRESHRATE, COMBOBOX, CBS_DROPDOWNLIST | WS_CHILD | WS_VISIBLE | WS_VSCROLL | WS_GROUP, 207, 131, 56, 64 
    CONTROL "*Software mixing only", IDC_CHECK_SOFTWAREMIXINGONLY, BUTTON, BS_AUTOCHECKBOX | BS_CENTER | BS_VCENTER | BS_PUSHLIKE | WS_CHILD | WS_VISIBLE | WS_GROUP, 283, 120, 129, 11 
    CONTROL "", IDC_CHECK_FULLSCREEN, BUTTON, BS_AUTOCHECKBOX | WS_CHILD | WS_VISIBLE, 136, 91, 9, 8 , WS_EX_TRANSPARENT
    CONTROL "*Bit depth", IDC_BITDEPTH, STATIC, SS_LEFT | SS_CENTERIMAGE | WS_CHILD | WS_VISIBLE | WS_GROUP, 133, 151, 66, 8 , WS_EX_TRANSPARENT
    CONTROL "", IDC_COMBO_BITDEPTH, COMBOBOX, CBS_DROPDOWNLIST | WS_CHILD | WS_VISIBLE | WS_VSCROLL | WS_GROUP, 207, 150, 56, 58 
    CONTROL " *Texture quality/size ", IDC_TEXTUREQUALITY, BUTTON, BS_GROUPBOX | WS_CHILD | WS_VISIBLE, 278, 5, 141, 55 
    CONTROL "     *Sound ", IDC_SOUND, BUTTON, BS_GROUPBOX | WS_CHILD | WS_VISIBLE, 278, 92, 141, 58 
    CONTROL "", IDC_CHECK_SOUND, BUTTON, BS_AUTOCHECKBOX | WS_CHILD | WS_VISIBLE, 284, 92, 9, 8 , WS_EX_TRANSPARENT
    CONTROL " *Lightmap quality/size ", IDC_LIGHTMAPQUALITY, BUTTON, BS_GROUPBOX | WS_CHILD | WS_VISIBLE, 278, 62, 141, 27 
    CONTROL "*Autodetect", IDC_BUTTON_AUTODETECT, BUTTON, BS_PUSHBUTTON | WS_CHILD | WS_VISIBLE | WS_TABSTOP, 5, 105, 115, 15 
    CONTROL " *Expert settings ", IDC_EXPERTSETTINGS, BUTTON, BS_GROUPBOX | WS_CHILD | WS_VISIBLE, 7, 171, 412, 40 
    CONTROL "*Open expert settings...", IDC_BUTTON_EXPERTSETTINGS, BUTTON, BS_PUSHBUTTON | WS_CHILD | WS_VISIBLE, 281, 153, 134, 15 
    CONTROL "*Clip always", IDC_CHECK_CLIPALWAYS, BUTTON, BS_AUTOCHECKBOX | BS_CENTER | BS_VCENTER | BS_PUSHLIKE | WS_CHILD | WS_VISIBLE | WS_GROUP, 213, 196, 68, 11 
    CONTROL "*Multipass rendering", IDC_CHECK_MULTIPASSRENDERING, BUTTON, BS_AUTOCHECKBOX | BS_CENTER | BS_VCENTER | BS_PUSHLIKE | WS_CHILD | WS_VISIBLE | WS_GROUP, 213, 181, 130, 11 
    CONTROL "*Fullscene antialiasing", IDC_ANTIALIASING, STATIC, SS_LEFT | WS_CHILD | WS_VISIBLE | WS_GROUP, 10, 84, 70, 8 
    CONTROL "", IDC_COMBO_ANTIALIASING, COMBOBOX, CBS_DROPDOWNLIST | WS_CHILD | WS_VISIBLE | WS_VSCROLL | WS_GROUP, 80, 82, 35, 51 
    CONTROL " *Display ", IDC_DISPLAY, BUTTON, BS_GROUPBOX | WS_CHILD | WS_VISIBLE, 5, 5, 115, 94 
    CONTROL "*Resolution", IDC_RESOLUTION, STATIC, SS_LEFT | WS_CHILD | WS_VISIBLE | WS_GROUP, 10, 65, 37, 8 
    CONTROL "", IDC_VRAMSIZE, EDIT, ES_LEFT | ES_READONLY | WS_CHILD | WS_VISIBLE, 10, 48, 102, 12 
    CONTROL "", IDC_COMBO_LANGUAGE, COMBOBOX, CBS_DROPDOWNLIST | WS_CHILD | NOT WS_VISIBLE | WS_VSCROLL | WS_TABSTOP, 353, 194, 50, 115 
    CONTROL "Language:", -1, STATIC, SS_LEFT | WS_CHILD | NOT WS_VISIBLE | WS_GROUP, 353, 182, 35, 8 
    CONTROL "", IDC_COMBO_SOUND, COMBOBOX, CBS_DROPDOWNLIST | WS_CHILD | WS_VISIBLE | WS_VSCROLL | WS_GROUP, 284, 103, 129, 69 
    CONTROL "*W Buffer", IDC_CHECK_WBUFFER, BUTTON, BS_AUTOCHECKBOX | BS_CENTER | BS_VCENTER | BS_PUSHLIKE | WS_CHILD | WS_VISIBLE | WS_GROUP, 288, 196, 55, 11
}
