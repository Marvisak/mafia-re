// Steam's Polish setup.exe (2002-10-30): its code is 1.2's tree a week before 1.2 (SETUP_DATE_POLISH), linked with
// this script. Its dialog is Polish-tagged, wider than 1.2's and in a block before the icon's; its strings are
// Polish but Czech-tagged, as in every setup. IDS_EXPERTSETTINGS lacks 1.2's padding spaces and IDS_TEXTUREQUALITY
// its trailing one, and IDS_SURROUNDSPEAKERS's "Głosniki" is the original's.

#include "resource.h"
#include <windows.h>

#pragma code_page(65001)

LANGUAGE LANG_CZECH, SUBLANG_DEFAULT

IDB_SPLASH BITMAP "splash.bmp"

STRINGTABLE
{
    IDS_DISPLAY, " Ekran "
    IDS_DRIVERVERSION, "Wersja sterownika: %d.%02d.%02d.%04d"
    IDS_RESOLUTION, "Rozdzielczość"
    IDS_ANTIALIASING, "Pełny antyaliasing"
    IDS_AUTODETECT, "Auto-wykrywanie"
    IDS_EXIT, "Wyjdź"
    IDS_SAVE, "Zapisz i wyjdź"
    IDS_EXPERTSETTINGS, "Ustawienia zaawansowane"
    IDS_HARDWARETRANSFORM, "Sprzętowe Transform&Lighting"
    IDS_SUSPENDWHENINACTIVE, "Zawieś przy braku aktywności"
    IDS_FULLSCREEN, "     Pełny ekran "
    IDS_TRIPLEBUFFERING, "Potrójne buforowanie"
    IDS_VSYNC, "Synchronizacja pionowa"
    IDS_REFRESHRATE, "Tempo odświeżania"
    IDS_BITDEPTH, "Paleta kolorów"
}

STRINGTABLE
{
    IDS_MULTIPASSRENDERING, "Rendering wieloprzebiegowy"
    IDS_CLIPALWAYS, "Zawsze przycinaj"
    IDS_WBUFFER, "Bufor W"
    IDS_TEXTUREQUALITY, " Jakość/rozmiar tekstur"
    IDS_TRUECOLOR, "Truecolor"
    IDS_LOWDETAIL, "Niski poziom detali"
    IDS_COMPRESSED, "Skompresowane"
    IDS_LIGHTMAPQUALITY, " Jakość/rozmiar map światła "
    IDS_SOUND, "     Dźwięk "
    IDS_SOFTWAREMIXINGONLY, "Wyłącznie miks programowy"
    IDS_DISABLEEAX, "Wyłącz EAX"
    IDS_OPENEXPERTSETTINGS, "Otwórz ustawienia zaawansowane..."
    IDS_CLOSEEXPERTSETTINGS, "Zamknij ustawienia zaawansowane..."
    IDS_DEFAULT, "Domyślnie"
    IDS_STEREOHEADPHONES, "Słuchawki stereo"
    IDS_STEREOSPEAKERS, "Głośniki stereo"
}

STRINGTABLE
{
    IDS_QUADROPHONICSPEAKERS, "Głośniki kwadrofoniczne"
    IDS_SURROUNDSPEAKERS, "Głosniki 5.1 surround"
    IDS_OFF, " WYŁ."
    IDS_SETUPERROR, "Błąd konfiguracji"
    IDS_DIRECTXENUMERROR, "DirectX : Urządzenia odpowiedzialne za grafikę nie zostały odnalezione."
    IDS_LOWVRAMWARNING, "Tekstury w trybie truecolor są zalecane wyłącznie\n\rdla kart graficznych z co najmniej 64MB pamięci RAM.\n\rKontynuować?"
    IDS_WARNING, "Ostrzeżenie"
    IDS_DISCARDCHANGES, "Zrezygnować ze zmian ?!"
    IDS_SETUP, "Konfiguracja"
}

LANGUAGE LANG_POLISH, SUBLANG_DEFAULT

IDD_MAIN DIALOGEX 0, 0, 403, 218
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_MINIMIZEBOX | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "Setup"
FONT 8, "MS Sans Serif"
{
    CONTROL IDB_SPLASH, IDC_BITMAP, STATIC, SS_BITMAP | WS_CHILD | WS_VISIBLE | WS_BORDER, 134, 5, 109, 71 
    CONTROL "", IDC_COMBO_DISPLAY, COMBOBOX, CBS_DROPDOWNLIST | WS_CHILD | WS_VISIBLE | WS_VSCROLL | WS_GROUP, 10, 15, 105, 69 
    CONTROL "", IDC_COMBO_RESOLUTION, COMBOBOX, CBS_DROPDOWNLIST | CBS_SORT | WS_CHILD | WS_VISIBLE | WS_VSCROLL | WS_GROUP, 59, 55, 56, 75 
    CONTROL "*Triple buffering", IDC_CHECK_TRIPLEBUFFERING, BUTTON, BS_AUTOCHECKBOX | BS_CENTER | BS_VCENTER | BS_PUSHLIKE | WS_CHILD | WS_VISIBLE | WS_GROUP, 135, 101, 118, 11 
    CONTROL "*Vertical synchronization", IDC_CHECK_VSYNC, BUTTON, BS_AUTOCHECKBOX | BS_CENTER | BS_VCENTER | BS_PUSHLIKE | WS_CHILD | WS_VISIBLE | WS_GROUP, 135, 116, 118, 11 
    CONTROL "*Truecolor", IDC_CHECK_TEXTURETRUECOLOR, BUTTON, BS_AUTOCHECKBOX | BS_CENTER | BS_VCENTER | BS_PUSHLIKE | WS_CHILD | WS_VISIBLE | WS_GROUP, 271, 15, 119, 11 
    CONTROL "*Low detail", IDC_CHECK_TEXTURELOWDETAIL, BUTTON, BS_AUTOCHECKBOX | BS_CENTER | BS_VCENTER | BS_PUSHLIKE | WS_CHILD | WS_VISIBLE | WS_GROUP, 271, 30, 119, 11 
    CONTROL "*Compressed", IDC_CHECK_TEXTURECOMPRESSED, BUTTON, BS_AUTOCHECKBOX | BS_CENTER | BS_VCENTER | BS_PUSHLIKE | WS_CHILD | WS_VISIBLE | WS_GROUP, 271, 45, 119, 11 
    CONTROL "*Truecolor", IDC_CHECK_LIGHTMAPTRUECOLOR, BUTTON, BS_AUTOCHECKBOX | BS_CENTER | BS_VCENTER | BS_PUSHLIKE | WS_CHILD | WS_VISIBLE | WS_GROUP, 271, 74, 119, 11 
    CONTROL "*Save and exit", IDC_BUTTON_SAVE, BUTTON, BS_DEFPUSHBUTTON | WS_CHILD | WS_VISIBLE | WS_TABSTOP, 5, 153, 115, 15 
    CONTROL "*Exit", IDC_BUTTON_EXIT, BUTTON, BS_PUSHBUTTON | WS_CHILD | WS_VISIBLE | WS_TABSTOP, 5, 133, 115, 15 
    CONTROL "", IDC_DRIVERVERSION, EDIT, ES_LEFT | ES_READONLY | WS_CHILD | WS_VISIBLE, 10, 29, 102, 12 
    CONTROL "*Disable EAX", IDC_CHECK_DISABLEEAX, BUTTON, BS_AUTOCHECKBOX | BS_CENTER | BS_VCENTER | BS_PUSHLIKE | WS_CHILD | WS_VISIBLE | WS_GROUP, 271, 134, 119, 11 
    CONTROL "*Suspend when inactive", IDC_CHECK_SUSPENDWHENINACTIVE, BUTTON, BS_AUTOCHECKBOX | BS_CENTER | BS_VCENTER | BS_PUSHLIKE | WS_CHILD | WS_VISIBLE | WS_GROUP, 15, 196, 110, 11 
    CONTROL "*Hardware Transform&&Lighting", IDC_CHECK_HARDWARETRANSFORM, BUTTON, BS_AUTOCHECKBOX | BS_CENTER | BS_VCENTER | BS_PUSHLIKE | WS_CHILD | WS_VISIBLE | WS_GROUP, 15, 181, 110, 11 
    CONTROL "     *Fullscreen ", IDC_FULLSCREEN, BUTTON, BS_GROUPBOX | WS_CHILD | WS_VISIBLE, 130, 91, 129, 77 
    CONTROL "*Refresh rate", IDC_REFRESHRATE, STATIC, SS_CENTER | SS_CENTERIMAGE | WS_CHILD | WS_VISIBLE | WS_GROUP, 136, 134, 68, 8 , WS_EX_TRANSPARENT
    CONTROL "", IDC_COMBO_REFRESHRATE, COMBOBOX, CBS_DROPDOWNLIST | WS_CHILD | WS_VISIBLE | WS_VSCROLL | WS_GROUP, 206, 131, 49, 64 
    CONTROL "*Software mixing only", IDC_CHECK_SOFTWAREMIXINGONLY, BUTTON, BS_AUTOCHECKBOX | BS_CENTER | BS_VCENTER | BS_PUSHLIKE | WS_CHILD | WS_VISIBLE | WS_GROUP, 271, 120, 119, 11 
    CONTROL "", IDC_CHECK_FULLSCREEN, BUTTON, BS_AUTOCHECKBOX | WS_CHILD | WS_VISIBLE, 136, 91, 9, 8 , WS_EX_TRANSPARENT
    CONTROL "*Bit depth", IDC_BITDEPTH, STATIC, SS_CENTER | SS_CENTERIMAGE | WS_CHILD | WS_VISIBLE | WS_GROUP, 136, 151, 68, 8 , WS_EX_TRANSPARENT
    CONTROL "", IDC_COMBO_BITDEPTH, COMBOBOX, CBS_DROPDOWNLIST | WS_CHILD | WS_VISIBLE | WS_VSCROLL | WS_GROUP, 206, 149, 49, 58 
    CONTROL " *Texture quality/size ", IDC_TEXTUREQUALITY, BUTTON, BS_GROUPBOX | WS_CHILD | WS_VISIBLE, 266, 5, 130, 55 
    CONTROL "     *Sound ", IDC_SOUND, BUTTON, BS_GROUPBOX | WS_CHILD | WS_VISIBLE, 266, 92, 130, 58 
    CONTROL "", IDC_CHECK_SOUND, BUTTON, BS_AUTOCHECKBOX | WS_CHILD | WS_VISIBLE, 272, 92, 9, 8 , WS_EX_TRANSPARENT
    CONTROL " *Lightmap quality/size ", IDC_LIGHTMAPQUALITY, BUTTON, BS_GROUPBOX | WS_CHILD | WS_VISIBLE, 266, 62, 130, 27 
    CONTROL "*Autodetect", IDC_BUTTON_AUTODETECT, BUTTON, BS_PUSHBUTTON | WS_CHILD | WS_VISIBLE | WS_TABSTOP, 5, 100, 115, 15 
    CONTROL " *Expert settings ", IDC_EXPERTSETTINGS, BUTTON, BS_GROUPBOX | WS_CHILD | WS_VISIBLE, 7, 171, 389, 40 
    CONTROL "*Open expert settings...", IDC_BUTTON_EXPERTSETTINGS, BUTTON, BS_PUSHBUTTON | WS_CHILD | WS_VISIBLE, 266, 153, 130, 15 
    CONTROL "*Clip always", IDC_CHECK_CLIPALWAYS, BUTTON, BS_AUTOCHECKBOX | BS_CENTER | BS_VCENTER | BS_PUSHLIKE | WS_CHILD | WS_VISIBLE | WS_GROUP, 135, 196, 68, 11 
    CONTROL "*Multipass rendering", IDC_CHECK_MULTIPASSRENDERING, BUTTON, BS_AUTOCHECKBOX | BS_CENTER | BS_VCENTER | BS_PUSHLIKE | WS_CHILD | WS_VISIBLE | WS_GROUP, 135, 181, 130, 11 
    CONTROL "*Fullscene antialiasing", IDC_ANTIALIASING, STATIC, SS_LEFT | WS_CHILD | WS_VISIBLE | WS_GROUP, 10, 77, 70, 8 
    CONTROL "", IDC_COMBO_ANTIALIASING, COMBOBOX, CBS_DROPDOWNLIST | WS_CHILD | WS_VISIBLE | WS_VSCROLL | WS_GROUP, 80, 75, 35, 51 
    CONTROL " *Display ", IDC_DISPLAY, BUTTON, BS_GROUPBOX | WS_CHILD | WS_VISIBLE, 5, 5, 115, 90 
    CONTROL "*Resolution", IDC_RESOLUTION, STATIC, SS_LEFT | WS_CHILD | WS_VISIBLE | WS_GROUP, 10, 57, 46, 8 
    CONTROL "", IDC_VRAMSIZE, EDIT, ES_LEFT | ES_READONLY | WS_CHILD | WS_VISIBLE, 10, 40, 102, 12 
    CONTROL "", IDC_COMBO_LANGUAGE, COMBOBOX, CBS_DROPDOWNLIST | WS_CHILD | NOT WS_VISIBLE | WS_VSCROLL | WS_TABSTOP, 288, 194, 100, 115 
    CONTROL "Language:", -1, STATIC, SS_LEFT | WS_CHILD | NOT WS_VISIBLE | WS_GROUP, 289, 182, 35, 8 
    CONTROL "", IDC_COMBO_SOUND, COMBOBOX, CBS_DROPDOWNLIST | WS_CHILD | WS_VISIBLE | WS_VSCROLL | WS_GROUP, 272, 103, 120, 69 
    CONTROL "*W Buffer", IDC_CHECK_WBUFFER, BUTTON, BS_AUTOCHECKBOX | BS_CENTER | BS_VCENTER | BS_PUSHLIKE | WS_CHILD | WS_VISIBLE | WS_GROUP, 210, 196, 55, 11
}

IDD_MAIN DLGINIT
{
    IDC_COMBO_ANTIALIASING, 0x403, 4, 0
    0x464f, 0x0046,
    0
}

LANGUAGE LANG_ENGLISH, SUBLANG_ENGLISH_US

IDI_SETUP ICON "mafia.ico"
