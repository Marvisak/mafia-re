{
    "version": 6,
    "configurePresets": [
        {
            "name": "vc6",
            "displayName": "VC6 SP5 + Processor Pack (original toolchain)",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/vc6",
            "toolchainFile": "${sourceDir}/cmake/vc6.cmake",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release"
            },
            "environment": {
                "PATH": "${sourceDir}/3rdparty/msvc600_sp5_vcpp/VC98/Bin;${sourceDir}/3rdparty/msvc600_sp5_vcpp/Common/MSDev98/Bin;${sourceDir}/.venv/Scripts;$penv{PATH}",
                "INCLUDE": "${sourceDir}/3rdparty/msvc600_sp5_vcpp/VC98/Include",
                "LIB": "${sourceDir}/3rdparty/msvc600_sp5_vcpp/VC98/Lib"
            }
        },
        {
            "name": "vc6-pdb",
            "inherits": "vc6",
            "displayName": "VC6 SP5 + Processor Pack with PDBs (for reccmp)",
            "binaryDir": "${sourceDir}/build/vc6-pdb",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "RelWithDebInfo"
            }
        },
        {
            "name": "vs2008",
            "displayName": "Visual C++ 2008 SP1 (Steam's 2010 setup.exe, with PDB for reccmp)",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/vs2008",
            "toolchainFile": "${sourceDir}/cmake/vs2008.cmake",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "SETUP_STEAM": "ON"
            },
            "environment": {
                "PATH": "${sourceDir}/3rdparty/msvc900_sp1/VC/bin;${sourceDir}/3rdparty/msvc900_sp1/Microsoft SDKs/Windows/v6.0A/Bin;${sourceDir}/.venv/Scripts;$penv{PATH}",
                "INCLUDE": "${sourceDir}/3rdparty/msvc900_sp1/VC/include;${sourceDir}/3rdparty/msvc900_sp1/Microsoft SDKs/Windows/v6.0A/Include;${sourceDir}/3rdparty/dx81sdk/include",
                "LIB": "${sourceDir}/3rdparty/msvc900_sp1/VC/lib;${sourceDir}/3rdparty/msvc900_sp1/Microsoft SDKs/Windows/v6.0A/Lib"
            }
        },
        {
            "name": "msvc",
            "displayName": "Installed Visual Studio, x86 (setup, functional builds; not matching)",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/msvc",
            "architecture": {
                "value": "x86",
                "strategy": "external"
            },
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "vc6",
            "configurePreset": "vc6"
        },
        {
            "name": "vc6-pdb",
            "configurePreset": "vc6-pdb"
        },
        {
            "name": "vs2008",
            "configurePreset": "vs2008"
        },
        {
            "name": "msvc",
            "configurePreset": "msvc"
        }
    ]
}
